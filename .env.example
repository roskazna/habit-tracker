# Личный ключ доступа к вашим serverless API.
# Один и тот же ключ вводится в приложении на компьютере и телефоне.
APP_ACCESS_KEY=replace-with-long-random-secret

# PostgreSQL URL для синхронизации данных между устройствами.
# Подойдет Neon, Supabase Postgres, Vercel Postgres или другой hosted Postgres.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Gemini ключ хранится только на сервере/хостинге, не в браузере.
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash
